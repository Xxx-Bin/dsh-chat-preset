  "engines": { "node": ">=18" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xxx-Bin/dsh-chat-preset.git"
  },
  "homepage": "https://github.com/Xxx-Bin/dsh-chat-preset#readme",
  "bugs": "https://github.com/Xxx-Bin/dsh-chat-preset/issues",
  "type": "module",
  "main": "index.js",
  "files": ["index.js", "cordis.patch.yml"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
